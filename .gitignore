# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code
CLAUDE.md
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# documentos internos del colegio: firma de la rectora y certificados con datos reales de estudiantes
/docs/certificados/


# scripts y datos de la base de datos: se ejecutan a mano en Supabase, no van al repositorio
/supabase/

# mockups para mostrar a la rectora: no son parte de la aplicación
/mockups/
